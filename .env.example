# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Proveedores IA
GEMINI_API_KEY=
KLING_API_KEY=
KLING_API_BASE_URL=https://api.klingapi.com
BFL_API_KEY=
BFL_API_BASE_URL=https://api.bfl.ai
ELEVENLABS_API_KEY=

# Seedance 2.0 (video). Provider por defecto: BytePlus ModelArk.
# SEEDANCE_PROVIDER=fal cambia Seedance a fal.ai (usa FAL_KEY de abajo) — útil
# para pruebas mientras tu cuenta de ModelArk activa el modelo. Vacío/otro = ModelArk.
SEEDANCE_PROVIDER=
# ModelArk: ARK_API_BASE_URL es opcional (default BytePlus global). Para
# Volcengine (China): https://ark.cn-beijing.volces.com/api/v3 (ids doubao-seedance-2-0-*)
ARK_API_KEY=
ARK_API_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# fal.ai (wrapper de Kling — klingapi.com no acepta nuevos signups)
FAL_KEY=

# QStash (Upstash) — cola de jobs para video/audio.
# QStash usa NEXT_PUBLIC_APP_URL (arriba) como base URL del worker.
# Para dev local override NEXT_PUBLIC_APP_URL con la URL de ngrok.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# QSTASH_URL es opcional. Default: https://qstash.upstash.io (global).
# Si tu cuenta vive en una región específica (ej. eu-central-1) y ves error
# "user not found in this region", copia la URL exacta del dashboard Upstash:
#   https://console.upstash.com → QStash → Details → REST URL
# Ejemplos: https://qstash.upstash.io (global) | https://eu-central-1-qstash.upstash.io
QSTASH_URL=
